# =============================================================================
# Atlas backend — copy to .env and adjust for your environment
#   cp .env.example .env
# =============================================================================

# --- Database (required) ---
# Local Homebrew Postgres example:
# DATABASE_URL=postgresql://atlas:YOUR_PASSWORD@localhost:5432/atlas_lab
DATABASE_URL=postgresql://atlas:change-me@localhost:5432/atlas_lab

# --- Auth (required) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Runtime ---
# development: default CORS http://localhost:5173 if CORS_ORIGINS is empty
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME="Atlas Laboratory Management System"
ARTIFICIAL_DELAY_MS=0

# --- Analyzer ingest (/lab/analyzer/*) ---
ANALYZER_API_KEY=change-me-in-production
ANALYZER_STRICT_VALIDATION=false

# --- Redis (optional; app runs without Redis if unreachable) ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_STATIC=3600

# --- Local file paths (optional) ---
REPORTS_DIR=./storage/reports
UPLOADS_DIR=./storage/uploads
