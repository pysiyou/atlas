{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas UI strings",
  "description": "Default terminology-aware UI copy; placeholders use {{patientCap}} style resolved at runtime from client-config",
  "type": "object",
  "required": ["modules", "tables", "filters", "emptyStates", "lab", "nav", "eventLog"],
  "additionalProperties": false,
  "properties": {
    "modules": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": [
        "patients",
        "newPatient",
        "patientDetail",
        "orders",
        "newOrder",
        "orderDetail",
        "payments",
        "reports",
        "catalog",
        "testDetail",
        "editPatient",
        "newPatientModal",
        "editOrder",
        "newOrderModal",
        "relatedOrders",
        "patientInformation",
        "viewPatient",
        "addOrder",
        "orderInformation",
        "orderActivity",
        "testsPanel",
        "reportsSubtitleAvailable",
        "users",
        "newUser",
        "userManagement",
        "labMonitor"
      ]
    },
    "tables": { "type": "object", "additionalProperties": true },
    "filters": { "type": "object", "additionalProperties": true },
    "emptyStates": { "type": "object", "additionalProperties": true },
    "lab": { "type": "object", "additionalProperties": true },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu", "settings", "mainAriaLabel", "main", "settingsLinks"],
      "properties": {
        "menu": { "type": "string" },
        "settings": { "type": "string" },
        "mainAriaLabel": { "type": "string" },
        "main": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dashboard",
            "patients",
            "orders",
            "laboratory",
            "tests",
            "payments",
            "reports",
            "catalog",
            "audit"
          ],
          "properties": {
            "dashboard": { "type": "string" },
            "patients": { "type": "string" },
            "orders": { "type": "string" },
            "laboratory": { "type": "string" },
            "tests": { "type": "string" },
            "payments": { "type": "string" },
            "reports": { "type": "string" },
            "catalog": { "type": "string" },
            "audit": { "type": "string" }
          }
        },
        "settingsLinks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["users", "notifications"],
          "properties": {
            "users": { "type": "string" },
            "notifications": { "type": "string" }
          }
        }
      }
    },
    "eventLog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panelTitle",
        "panelMetaOrder",
        "panelMetaLab",
        "panelMetaPatient",
        "panelMetaRecord",
        "panelMetaCommandCenter",
        "panelMetaMonitor",
        "panelMetaAll",
        "emptyTitle",
        "emptyDescription",
        "narrativeDefaultLabel",
        "reasonInlinePrefix",
        "outcomeInlinePrefix",
        "commentLabel",
        "resultTitle",
        "debugTitle",
        "loadMore",
        "searchPreviewTitle",
        "searchPreviewRecordIds",
        "searchPreviewPatients",
        "searchPreviewUsers",
        "searchPreviewEventCount",
        "searchPreviewEventCountLoading",
        "searchPreviewNoSuggestions",
        "searchIntentOrder",
        "searchIntentTest",
        "searchIntentSample",
        "searchIntentPatient",
        "searchIntentNumericTarget",
        "verbositySummary",
        "verbosityDetailed",
        "verbosityDebug",
        "showMore",
        "showLess",
        "systemActorName",
        "transitionArrow"
      ],
      "properties": {
        "panelTitle": { "type": "string" },
        "panelMetaOrder": { "type": "string" },
        "panelMetaLab": { "type": "string" },
        "panelMetaPatient": { "type": "string" },
        "panelMetaRecord": { "type": "string" },
        "panelMetaCommandCenter": { "type": "string" },
        "panelMetaMonitor": { "type": "string" },
        "panelMetaAll": { "type": "string" },
        "emptyTitle": { "type": "string" },
        "emptyDescription": { "type": "string" },
        "narrativeDefaultLabel": { "type": "string" },
        "reasonInlinePrefix": { "type": "string" },
        "outcomeInlinePrefix": { "type": "string" },
        "commentLabel": { "type": "string" },
        "resultTitle": { "type": "string" },
        "debugTitle": { "type": "string" },
        "loadMore": { "type": "string" },
        "searchPreviewTitle": { "type": "string" },
        "searchPreviewRecordIds": { "type": "string" },
        "searchPreviewPatients": { "type": "string" },
        "searchPreviewUsers": { "type": "string" },
        "searchPreviewEventCount": { "type": "string" },
        "searchPreviewEventCountLoading": { "type": "string" },
        "searchPreviewNoSuggestions": { "type": "string" },
        "searchIntentOrder": { "type": "string" },
        "searchIntentTest": { "type": "string" },
        "searchIntentSample": { "type": "string" },
        "searchIntentPatient": { "type": "string" },
        "searchIntentNumericTarget": { "type": "string" },
        "verbositySummary": { "type": "string" },
        "verbosityDetailed": { "type": "string" },
        "verbosityDebug": { "type": "string" },
        "showMore": { "type": "string" },
        "showLess": { "type": "string" },
        "systemActorName": { "type": "string" },
        "transitionArrow": { "type": "string" }
      }
    }
  }
}
