{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas Client Configuration",
  "description": "White-label configuration for Atlas LIS deployments",
  "type": "object",
  "required": ["company", "branding"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["name", "displayName"],
      "properties": {
        "name": { 
          "type": "string",
          "description": "Short company name"
        },
        "displayName": { 
          "type": "string",
          "description": "Display name shown in UI"
        },
        "fullName": { 
          "type": "string",
          "description": "Full legal company name"
        },
        "subtitle": { 
          "type": "string",
          "description": "Company subtitle or slogan"
        },
        "tagline": { 
          "type": "string",
          "description": "Marketing tagline"
        },
        "version": { 
          "type": "string",
          "description": "Application version"
        },
        "copyright": { 
          "type": "string",
          "description": "Copyright notice"
        },
        "contact": {
          "type": "object",
          "description": "Contact information",
          "properties": {
            "address": { 
              "type": "object",
              "properties": {
                "street": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zipCode": { "type": "string" },
                "country": { "type": "string" },
                "fullAddress": { "type": "string" }
              },
              "required": ["street", "city", "state", "zipCode", "country"]
            },
            "phone": { 
              "type": "array", 
              "items": { "type": "string" },
              "description": "Contact phone numbers"
            },
            "email": { 
              "type": "string",
              "format": "email",
              "description": "Contact email address"
            },
            "website": { 
              "type": "string",
              "description": "Company website"
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "required": ["logoPath", "primaryColor"],
      "properties": {
        "logoPath": { 
          "type": "string",
          "description": "Path to company logo (relative to public directory or icon registry)"
        },
        "primaryColor": { 
          "type": "string", 
          "pattern": "^#[0-9a-fA-F]{3,6}$",
          "description": "Primary brand color (hex format)"
        },
        "secondaryColor": { 
          "type": "string", 
          "pattern": "^#[0-9a-fA-F]{3,6}$",
          "description": "Secondary brand color (hex format)"
        },
        "defaultTheme": { 
          "type": "string",
          "enum": ["studio-light", "studio-dark", "system"],
          "description": "Default theme to apply on startup"
        }
      }
    },
    "terminology": {
      "type": "object",
      "description": "Custom terminology mappings for white-labeling UI copy",
      "additionalProperties": { "type": "string" },
      "properties": {
        "patient": { "type": "string" },
        "patients": { "type": "string" },
        "order": { "type": "string" },
        "orders": { "type": "string" },
        "test": { "type": "string" },
        "tests": { "type": "string" },
        "sample": { "type": "string" },
        "samples": { "type": "string" },
        "laboratory": { "type": "string" },
        "report": { "type": "string" },
        "reports": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "description": "Feature flags to enable/disable modules",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "dashboard": { "type": "boolean", "description": "Enable dashboard module" },
        "patients": { "type": "boolean", "description": "Enable patient management" },
        "orders": { "type": "boolean", "description": "Enable order management" },
        "payments": { "type": "boolean", "description": "Enable payment processing" },
        "reports": { "type": "boolean", "description": "Enable report generation" },
        "catalog": { "type": "boolean", "description": "Enable test catalog" },
        "laboratory": { "type": "boolean", "description": "Enable laboratory workflows" },
        "labCollection": { "type": "boolean", "description": "Enable sample collection" },
        "labEntry": { "type": "boolean", "description": "Enable result entry" },
        "labValidation": { "type": "boolean", "description": "Enable result validation" },
        "labMonitor": { "type": "boolean", "description": "Enable lab monitoring" },
        "audit": { "type": "boolean", "description": "Enable audit log" },
        "users": { "type": "boolean", "description": "Enable user management" }
      }
    },
    "workflows": {
      "type": "object",
      "description": "Workflow behavior flags",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "requirePaymentBeforeCollection": { 
          "type": "boolean",
          "description": "Require payment before sample collection"
        },
        "requireDoctorApproval": { 
          "type": "boolean",
          "description": "Require doctor approval before collection"
        },
        "requireDualValidation": { 
          "type": "boolean",
          "description": "Require two validators for result validation"
        },
        "requireEmergencyContact": { 
          "type": "boolean",
          "description": "Require emergency contact for patients"
        }
      }
    },
    "reports": {
      "type": "object",
      "description": "Report generation configuration",
      "properties": {
        "headerText": { 
          "type": "string",
          "description": "Header text for PDF reports"
        },
        "footerText": { 
          "type": "string",
          "description": "Footer text for PDF reports"
        },
        "includeSignature": { 
          "type": "boolean",
          "description": "Include signature block in reports",
          "default": true
        }
      }
    },
    "marketing": {
      "type": "object",
      "description": "Marketing content for login screen (optional)",
      "properties": {
        "features": { 
          "type": "array",
          "items": { "type": "string" },
          "description": "Feature bullets to display on login screen"
        },
        "description": { 
          "type": "string",
          "description": "Marketing description for login screen"
        }
      }
    }
  }
}
