# Atlas monorepo — copy service env files from the examples below.
#
# Local development (quick start):
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#   # Edit backend/.env DATABASE_URL and SECRET_KEY
#   # Fresh DB: poetry run python -m app.platform.bootstrap  (from backend/)
#
# Backend:  backend/.env
# Frontend: frontend/.env (and frontend/.env.development for Vite dev server)
