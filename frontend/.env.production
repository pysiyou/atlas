# Environment Variables - Production
# These should be set in your production environment

# API Configuration
VITE_API_BASE_URL=https://api.atlas-lims.com/api/v1
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_USE_LOCAL_STORAGE=false

# Application
VITE_APP_NAME=Atlas LIMS
VITE_APP_VERSION=1.0.0

# Instance theme pair (UI only exposes Light / Dark)
VITE_THEME_LIGHT=playful-light
VITE_THEME_DARK=noir-studio

# Logging
VITE_LOG_LEVEL=info
