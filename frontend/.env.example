# =============================================================================
# Atlas frontend — copy to .env for local builds; Vite also reads .env.development
#   cp .env.example .env
# =============================================================================

# Backend API (must match backend listen URL + API_V1_PREFIX)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# Theme pair (UI toggles Light / Dark only)
VITE_THEME_LIGHT=studio-light
VITE_THEME_DARK=noir-studio

# Optional
VITE_ENABLE_MOCK_API=false
VITE_USE_LOCAL_STORAGE=false
VITE_APP_NAME=Atlas LIMS
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=debug
