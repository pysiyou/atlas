{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "knip": "npx knip --tsConfig tsconfig.app.json",
    "codegen:feedback": "node ../scripts/generate-feedback-catalog.mjs",
    "codegen:audit": "node ../scripts/generate-audit-catalog.mjs",
    "codegen:client-config": "node ../scripts/generate-client-config-types.mjs",
    "codegen:workups": "node ../scripts/generate-workups.mjs",
    "codegen:catalog": "node ../scripts/generate-catalog-contract-types.mjs",
    "codegen:rejection": "node ../scripts/generate-rejection-reasons.mjs",
    "codegen:enums": "node ../scripts/generate-enums.mjs",
    "codegen:entity-ids": "node ../scripts/generate-entity-ids.mjs",
    "codegen:contracts": "node ../scripts/codegen-contracts.mjs",
    "codegen:openapi": "python ../scripts/export-openapi.py && openapi-typescript ../contracts/openapi.json -o src/lib/api/types/generated/api.d.ts",
    "codegen": "npm run codegen:contracts && npm run codegen:openapi && npm run codegen:client-config",
    "validate:catalog": "node ../scripts/validate-catalog.mjs",
    "validate:client-config": "node ../scripts/validate-client-config.mjs",
    "validate:ui-strings": "node ../scripts/validate-ui-strings.mjs",
    "validate": "npm run validate:catalog && npm run validate:client-config && npm run validate:ui-strings",
    "check:openapi": "python ../scripts/export-openapi.py && git diff --exit-code ../contracts/openapi.json src/lib/api/types/generated/api.d.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/query-sync-storage-persister": "^5.90.19",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-persist-client": "^5.90.19",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.25.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "^4.0.0",
    "openapi-typescript": "^7.4.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
