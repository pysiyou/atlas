{"type":"frame-snapshot","snapshot":{"callId":"call@11","phase":"after","pageId":"page@a11f5f0f3dcd0d3e3ab46e0f944002bf","frameId":"frame@4d2314beed0898730729d2094c8d5bd4","frameUrl":"http://localhost:5173/login","doctype":"html","html":["HTML",{"lang":"en","class":"theme-transitioning","data-theme":"noir-studio"},["HEAD",{},["BASE",{"href":"http://localhost:5173/login"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/icons/app-logo.svg"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["TITLE",{},"CargoPlan"],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n    ",["LINK",{"href":"https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap","rel":"stylesheet"}],"\n  ",["STYLE",{}," @keyframes go2264125279{from{transform:scale(0) rotate(45deg);opacity:0;}to{transform:scale(1) rotate(45deg);opacity:1;}}@keyframes go3020080000{from{transform:scale(0);opacity:0;}to{transform:scale(1);opacity:1;}}@keyframes go463499852{from{transform:scale(0) rotate(90deg);opacity:0;}to{transform:scale(1) rotate(90deg);opacity:1;}}@keyframes go1268368563{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}@keyframes go1310225428{from{transform:scale(0) rotate(45deg);opacity:0;}to{transform:scale(1) rotate(45deg);opacity:1;}}@keyframes go651618207{0%{height:0;width:0;opacity:0;}40%{height:0;width:6px;opacity:1;}100%{opacity:1;height:10px;}}@keyframes go901347462{from{transform:scale(0.6);opacity:0.4;}to{transform:scale(1);opacity:1;}}.go4109123758{z-index:9999;}.go4109123758 > *{pointer-events:auto;}"],["STYLE",{},"/* ═══════════════════════════════════════════════════════════════════════════\n   ATLAS DESIGN SYSTEM - THEME TOKENS\n   Architecture: Primitives → Semantic → Tailwind → Components\n   ═══════════════════════════════════════════════════════════════════════════ */\n\n/* ─────────────────────────────────────────────────────────────────────────\n   LEVEL 1: PRIMITIVE TOKENS\n   Raw color values with no semantic meaning. Theme-agnostic.\n   ───────────────────────────────────────────────────────────────────────── */\n\n:root {\n  --font-sans: 'Nunito', sans-serif;\n  /* Font weight scale (Tailwind-aligned); default = light */\n  --font-weight-thin: 200;\n  --font-weight-extralight: 300;\n  --font-weight-light: 400;\n  --font-weight-normal: 500;\n  --font-weight-medium: 600;\n  --font-weight-semibold: 700;\n  --font-weight-bold: 800;\n  --font-weight-extrabold: 900;\n  --font-weight-black: 900;\n  --font-weight-default: var(--font-weight-extralight);\n\n  /* Brand Palette - Primary action color */\n  --primitive-brand-50: #f0f9ff;\n  --primitive-brand-100: #e0f2fe;\n  --primitive-brand-200: #bae6fd;\n  --primitive-brand-300: #7dd3fc;\n  --primitive-brand-400: #38bdf8;\n  --primitive-brand-500: #0ea5e9;\n  --primitive-brand-600: #0284c7;\n  --primitive-brand-700: #0369a1;\n  --primitive-brand-800: #075985;\n  --primitive-brand-900: #0c4a6e;\n  --primitive-brand-950: #082f49;\n\n  /* Neutral Palette - Grays for text, borders, surfaces */\n  --primitive-neutral-0: #ffffff;\n  --primitive-neutral-50: #f9fafb;\n  --primitive-neutral-100: #f3f4f6;\n  --primitive-neutral-200: #e5e7eb;\n  --primitive-neutral-300: #d1d5db;\n  --primitive-neutral-400: #9ca3af;\n  --primitive-neutral-500: #6b7280;\n  --primitive-neutral-600: #4b5563;\n  --primitive-neutral-700: #374151;\n  --primitive-neutral-800: #1f2937;\n  --primitive-neutral-900: #111827;\n  --primitive-neutral-950: #030712;\n\n  /* Success Palette */\n  --primitive-success-50: #f0fdf4;\n  --primitive-success-100: #dcfce7;\n  --primitive-success-200: #bbf7d0;\n  --primitive-success-500: #22c55e;\n  --primitive-success-600: #16a34a;\n  --primitive-success-700: #15803d;\n  --primitive-success-800: #166534;\n\n  /* Warning Palette */\n  --primitive-warning-50: #fffbeb;\n  --primitive-warning-100: #fef3c7;\n  --primitive-warning-200: #fde68a;\n  --primitive-warning-300: #fcd34d;\n  --primitive-warning-500: #eab308;\n  --primitive-warning-600: #ca8a04;\n  --primitive-warning-700: #a16207;\n  --primitive-warning-800: #854d0e;\n\n  /* Danger Palette */\n  --primitive-danger-50: #fef2f2;\n  --primitive-danger-100: #fee2e2;\n  --primitive-danger-200: #fecaca;\n  --primitive-danger-500: #ef4444;\n  --primitive-danger-600: #dc2626;\n  --primitive-danger-700: #b91c1c;\n  --primitive-danger-800: #991b1b;\n\n  /* Info Palette (Purple accent) */\n  --primitive-info-400: #a78bfa;\n  --primitive-info-500: #8b5cf6;\n\n  /* Extended badge palettes (purple, pink, teal, orange, indigo, cyan) */\n  --primitive-purple-100: #f3e8ff;\n  --primitive-purple-500: #a855f7;\n  --primitive-purple-600: #9333ea;\n  --primitive-purple-800: #6b21a8;\n  --primitive-pink-100: #fce7f3;\n  --primitive-pink-500: #ec4899;\n  --primitive-pink-600: #db2777;\n  --primitive-pink-800: #9d174d;\n  --primitive-teal-100: #ccfbf1;\n  --primitive-teal-500: #14b8a6;\n  --primitive-teal-600: #0d9488;\n  --primitive-teal-800: #115e59;\n  --primitive-orange-100: #ffedd5;\n  --primitive-orange-500: #f97316;\n  --primitive-orange-600: #ea580c;\n  --primitive-orange-800: #9a3412;\n  --primitive-indigo-100: #e0e7ff;\n  --primitive-indigo-500: #6366f1;\n  --primitive-indigo-600: #4f46e5;\n  --primitive-indigo-800: #3730a3;\n  --primitive-cyan-100: #cffafe;\n  --primitive-cyan-500: #06b6d4;\n  --primitive-cyan-600: #0891b2;\n  --primitive-cyan-800: #155e75;\n}\n\n/* ─────────────────────────────────────────────────────────────────────────\n   LEVEL 2: SEMANTIC TOKENS - LIGHT THEME (studio-light)\n   Tokens with meaning. These change per theme.\n   ───────────────────────────────────────────────────────────────────────── */\n\n:root {\n  /* ═══════════════════════════════════════════════════════════════════\n     TEXT (Foreground / Text & Icons)\n     Usage: text-primary, text-secondary, text-tertiary, text-muted, etc.\n     ═══════════════════════════════════════════════════════════════════ */\n  --text: var(--primitive-neutral-900); /* Primary text */\n  --text-secondary: var(--primitive-neutral-600); /* Secondary text */\n  --text-tertiary: var(--primitive-neutral-500); /* Tertiary text */\n  --text-muted: var(--primitive-neutral-400); /* Placeholder, hints */\n  --text-disabled: var(--primitive-neutral-300); /* Disabled state */\n  --text-inverse: var(--primitive-neutral-0); /* Text on dark bg */\n\n  /* ═══════════════════════════════════════════════════════════════════\n     SURFACE (Page & Component Backgrounds)\n     Usage: bg-surface-page, bg-surface, bg-surface-hover, bg-surface-selected\n     ═══════════════════════════════════════════════════════════════════ */\n  --surface-page: var(--primitive-neutral-50); /* Page/app background */\n  --surface: var(--primitive-neutral-0); /* Default component bg */\n  --surface-hover: var(--primitive-neutral-50); /* Hover state */\n  --surface-selected: var(--primitive-brand-100); /* Selected state */\n  --surface-elev: var(--primitive-neutral-0); /* Elevated surface */\n  --surface-report: #e0f2f7; /* Report background (light) */\n\n  /* ═══════════════════════════════════════════════════════════════════\n     BORDER (Borders & Dividers)\n     Usage: border-default, border-subtle, border-strong\n     ═══════════════════════════════════════════════════════════════════ */\n  --border: var(--primitive-neutral-200); /* Default border */\n  --border-subtle: var(--primitive-neutral-100); /* Subtle divider */\n  --border-strong: var(--primitive-neutral-300); /* Emphasized border */\n  --border-hover: var(--primitive-neutral-300); /* Border on hover */\n  --border-focus: var(--primitive-brand-600); /* Focus ring color */\n  --border-error: var(--primitive-danger-600); /* Error state border */\n\n  /* ═══════════════════════════════════════════════════════════════════\n     BRAND (Primary Action)\n     Usage: bg-brand, text-brand, border-brand, text-on-brand\n     ═══════════════════════════════════════════════════════════════════ */\n  --brand: var(--primitive-brand-600); /* Primary action */\n  --brand-hover: var(--primitive-brand-700); /* Hover state */\n  --brand-muted: var(--primitive-brand-100); /* Muted background */\n  --brand-fg: var(--primitive-brand-800); /* Text on muted bg */\n  --on-brand: var(--primitive-neutral-0); /* Text ON brand bg */\n\n  /* ═══════════════════════════════════════════════════════════════════\n     DANGER (Destructive Actions)\n     Usage: bg-danger, text-danger-fg, border-danger\n     ═══════════════════════════════════════════════════════════════════ */\n  --danger: var(--primitive-danger-600);\n  --danger-hover: var(--primitive-danger-700);\n  --on-danger: var(--primitive-neutral-0);\n\n  /* Danger feedback (alerts, badges) */\n  --danger-bg: var(--primitive-danger-50);\n  --danger-bg-emphasis: var(--primitive-danger-100);\n  --danger-fg: var(--primitive-danger-600);\n  --danger-fg-emphasis: var(--primitive-danger-700);\n  --danger-stroke: var(--primitive-danger-200);\n  --danger-stroke-emphasis: var(--primitive-danger-600);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     SUCCESS (Positive States)\n     Usage: bg-success, text-success-fg\n     ═══════════════════════════════════════════════════════════════════ */\n  --success: var(--primitive-success-600);\n  --on-success: var(--primitive-neutral-0);\n\n  /* Success feedback */\n  --success-bg: var(--primitive-success-50);\n  --success-bg-emphasis: var(--primitive-success-100);\n  --success-fg: var(--primitive-success-600);\n  --success-fg-emphasis: var(--primitive-success-700);\n  --success-stroke: var(--primitive-success-200);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     WARNING (Cautionary States)\n     Usage: bg-warning, text-warning-fg\n     ═══════════════════════════════════════════════════════════════════ */\n  --warning: var(--primitive-warning-500);\n  --on-warning: var(--primitive-neutral-950);\n\n  /* Warning feedback */\n  --warning-bg: var(--primitive-warning-50);\n  --warning-bg-emphasis: var(--primitive-warning-100);\n  --warning-fg: var(--primitive-warning-700);\n  --warning-fg-emphasis: var(--primitive-warning-800);\n  --warning-stroke: var(--primitive-warning-200);\n  --warning-stroke-emphasis: var(--primitive-warning-300);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     INFO (Informational)\n     Usage: bg-info, text-info-fg\n     ═══════════════════════════════════════════════════════════════════ */\n  --info: var(--primitive-info-500);\n  --info-bg: rgba(139, 92, 246, 0.08);\n  --info-bg-emphasis: rgba(139, 92, 246, 0.15);\n  --info-fg: var(--primitive-info-500);\n  --info-fg-emphasis: var(--primitive-info-400);\n  --info-stroke: rgba(139, 92, 246, 0.25);\n  --on-info: var(--primitive-neutral-0);\n  /* Success/warning gaps */\n  --success-hover: var(--primitive-success-700);\n  --success-stroke-emphasis: var(--primitive-success-600);\n  --warning-hover: var(--primitive-warning-600);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     EXTENDED BADGE COLORS (theme-responsive)\n     Usage: text-purple-fg-emphasis, bg-purple-bg-emphasis (badges)\n     ═══════════════════════════════════════════════════════════════════ */\n  --purple-fg-emphasis: var(--primitive-purple-600);\n  --purple-bg-emphasis: var(--primitive-purple-100);\n  --pink-fg-emphasis: var(--primitive-pink-600);\n  --pink-bg-emphasis: var(--primitive-pink-100);\n  --teal-fg-emphasis: var(--primitive-teal-600);\n  --teal-bg-emphasis: var(--primitive-teal-100);\n  --orange-fg-emphasis: var(--primitive-orange-600);\n  --orange-bg-emphasis: var(--primitive-orange-100);\n  --indigo-fg-emphasis: var(--primitive-indigo-600);\n  --indigo-bg-emphasis: var(--primitive-indigo-100);\n  --cyan-fg-emphasis: var(--primitive-cyan-600);\n  --cyan-bg-emphasis: var(--primitive-cyan-100);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     BADGE\n     Usage: bg-badge (unified mode background)\n     ═══════════════════════════════════════════════════════════════════ */\n  --badge: var(--primitive-neutral-0);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     CHART\n     Usage: stroke-chart-grid, text-chart-axis, bg-chart-tooltip\n     ═══════════════════════════════════════════════════════════════════ */\n  --chart-grid: var(--primitive-neutral-200);\n  --chart-axis: var(--primitive-neutral-500);\n  --chart-tooltip: var(--primitive-neutral-0);\n  --chart-tooltip-stroke: var(--primitive-neutral-200);\n  --chart-brand: var(--primitive-brand-500);\n  --chart-success: var(--primitive-success-600);\n  --chart-danger: var(--primitive-danger-500);\n  --chart-accent: var(--primitive-info-500);\n  --chart-accent-muted: var(--primitive-info-400);\n  --chart-tooltip-border: var(--chart-tooltip-stroke);\n  --chart-primary: var(--chart-brand);\n  --chart-accent-light: var(--chart-accent-muted);\n  --chart-warning: var(--primitive-warning-500);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     TEST CATEGORY (breakdowns / charts)\n     Usage: bg-category-hematology\n     ═══════════════════════════════════════════════════════════════════ */\n  --category-hematology: var(--chart-danger);\n  --category-biochemistry: var(--chart-warning);\n  --category-chemistry: var(--orange-fg-emphasis);\n  --category-microbiology: var(--teal-fg-emphasis);\n  --category-serology: var(--indigo-fg-emphasis);\n  --category-urinalysis: var(--cyan-fg-emphasis);\n  --category-imaging: var(--purple-fg-emphasis);\n  --category-immunology: var(--pink-fg-emphasis);\n  --category-molecular: var(--chart-accent);\n  --category-toxicology: var(--chart-success);\n  --category-coagulation: var(--danger-fg-emphasis);\n  --category-default: var(--chart-brand);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     OVERLAY\n     Usage: bg-overlay (modal backdrop)\n     ═══════════════════════════════════════════════════════════════════ */\n  --overlay: rgba(0, 0, 0, 0.5);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     SHADOWS\n     Usage: shadow-sm, shadow-md, shadow-footer\n     ═══════════════════════════════════════════════════════════════════ */\n  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\n  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n  --shadow-footer: 0 -1px 3px rgba(0, 0, 0, 0.04);\n  --shadow-1: var(--shadow-sm);\n  --shadow-2: var(--shadow-md);\n  --shadow-3: var(--shadow-lg);\n  --state-disabled-opacity: 0.5;\n\n  /* ═══════════════════════════════════════════════════════════════════\n     TONE SYSTEM (Unified feedback pattern for badges/alerts)\n     Usage: bg-tone-danger-bg, text-tone-danger-text, border-tone-danger-border\n     ═══════════════════════════════════════════════════════════════════ */\n  --tone-neutral-bg: var(--surface-hover);\n  --tone-neutral-text: var(--text-secondary);\n  --tone-neutral-border: var(--border);\n  --tone-info-bg: var(--info-bg);\n  --tone-info-text: var(--info-fg);\n  --tone-info-border: var(--info-stroke);\n  --tone-success-bg: var(--success-bg);\n  --tone-success-text: var(--success-fg);\n  --tone-success-border: var(--success-stroke);\n  --tone-warning-bg: var(--warning-bg);\n  --tone-warning-text: var(--warning-fg);\n  --tone-warning-border: var(--warning-stroke);\n  --tone-danger-bg: var(--danger-bg);\n  --tone-danger-text: var(--danger-fg);\n  --tone-danger-border: var(--danger-stroke);\n  --tone-accent-bg: var(--brand-muted);\n  --tone-accent-text: var(--brand-fg);\n  --tone-accent-border: var(--brand);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     ENTITY ID (patient, order, sample, test codes, etc.)\n     Usage: class=\"entity-id\" or text-id font-id\n     ═══════════════════════════════════════════════════════════════════ */\n  --id-font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',\n    'Courier New', monospace;\n  --id-font-size: 0.75rem;\n  --id-font-size-secondary: var(--text-xxs);\n  --id-color: var(--brand);\n  --id-color-secondary: var(--text-tertiary);\n  --id-letter-spacing: 0.02em;\n  --id-font-weight: var(--font-weight-normal);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     FOCUS\n     Usage: ring-focus (focus ring color)\n     ═══════════════════════════════════════════════════════════════════ */\n  --focus: var(--primitive-brand-600);\n\n  /* ═══════════════════════════════════════════════════════════════════\n     TOAST\n     Special: Dark theme always (inverted from page theme)\n     ═══════════════════════════════════════════════════════════════════ */\n  --toast-bg: #333333;\n  --toast-fg: #ffffff;\n  --toast-fg-muted: #cccccc;\n  --toast-close: #e0e0e0;\n  --toast-success: #6cd96d;\n  --toast-info: #2196f3;\n  --toast-warning: #ffc107;\n  --toast-danger: #f44336;\n\n  /* ═══════════════════════════════════════════════════════════════════\n     AUTH (Isolated module - different visual language)\n     ═══════════════════════════════════════════════════════════════════ */\n  --auth-canvas: #1a1f2e;\n  --auth-panel: #232938;\n  --auth-panel-hover: #283040;\n  --auth-input-bg: #232938;\n  --auth-input-border: #2d3548;\n  --auth-input-border-focus: #4a6670;\n  --auth-text-primary: #e8eaed;\n  --auth-text-secondary: #b0b8c8;\n  --auth-text-muted: #6b7280;\n  --auth-text-light: #7a9ba8;\n  --auth-accent: #3d5a66;\n  --auth-accent-medium: #4a6b78;\n  --auth-accent-hover: #4a6b78;\n  --auth-border: #2d3548;\n  --auth-border-light: #3a4455;\n  --auth-border-hover: #3d4760;\n  --auth-error-bg: #3d2a2e;\n  --auth-error-bg-light: #4a3035;\n  --auth-error-border: #5a3a40;\n  --auth-error-text: #d4989d;\n  --auth-feature-card-bg: #232938;\n  --auth-feature-card-hover: #283040;\n  --auth-feature-card-border: #2d3548;\n  --auth-card-icon-bg: #2d3548;\n  --auth-card-icon-hover: #3a4455;\n  --auth-card-icon-border: #2d3548;\n  --auth-badge-bg: #2d3548;\n  --auth-badge-border: #232938;\n  --auth-badge-icon: #7a9ba8;\n}\n\n/* ─────────────────────────────────────────────────────────────────────────\n   DARK THEME: github\n   Primitives change + semantic token overrides\n   ───────────────────────────────────────────────────────────────────────── */\n\n[data-theme='github'] {\n  /* Primitive overrides for github theme */\n  --primitive-brand-50: #eef6ff;\n  --primitive-brand-100: #ddecff;\n  --primitive-brand-200: #bcdaff;\n  --primitive-brand-300: #8bc0ff;\n  --primitive-brand-400: #58a0ff;\n  --primitive-brand-500: #1f6feb;\n  --primitive-brand-600: #1a5fd4;\n  --primitive-brand-700: #144aad;\n  --primitive-brand-800: #0f3685;\n  --primitive-brand-900: #0c2d6b;\n  --primitive-brand-950: #081a42;\n\n  --primitive-neutral-0: #0b0f16;\n  --primitive-neutral-50: #0d1117;\n  --primitive-neutral-100: #161b22;\n  --primitive-neutral-200: #21262d;\n  --primitive-neutral-300: #30363d;\n  --primitive-neutral-400: #484f58;\n  --primitive-neutral-500: #6e7681;\n  --primitive-neutral-600: #8b949e;\n  --primitive-neutral-700: #cacaca;\n  --primitive-neutral-800: #f5f5f5;\n  --primitive-neutral-900: #ffffff;\n  --primitive-neutral-950: #000000;\n\n  --primitive-success-50: #0d2818;\n  --primitive-success-100: #134d22;\n  --primitive-success-200: #157b2e;\n  --primitive-success-500: #2ea043;\n  --primitive-success-600: #238636;\n  --primitive-success-700: #196c2e;\n  --primitive-success-800: #145c26;\n\n  --primitive-warning-50: #3d2e0a;\n  --primitive-warning-100: #5c4410;\n  --primitive-warning-200: #8b6916;\n  --primitive-warning-300: #b88620;\n  --primitive-warning-500: #d29922;\n  --primitive-warning-600: #9e6a03;\n  --primitive-warning-700: #7d5402;\n  --primitive-warning-800: #5c3e02;\n\n  --primitive-danger-50: #3d1616;\n  --primitive-danger-100: #5c2222;\n  --primitive-danger-200: #8b2d2d;\n  --primitive-danger-500: #da3633;\n  --primitive-danger-600: #b62c29;\n  --primitive-danger-700: #912320;\n  --primitive-danger-800: #6b1a18;\n\n  --primitive-info-500: #1f6feb;\n  --primitive-info-400: #58a0ff;\n\n  --primitive-purple-100: #2d1b4e;\n  --primitive-purple-500: #a371f7;\n  --primitive-purple-600: #8957e6;\n  --primitive-purple-800: #c4b5fd;\n  --primitive-pink-100: #3d1f35;\n  --primitive-pink-500: #db61a2;\n  --primitive-pink-600: #e35998;\n  --primitive-pink-800: #f778ba;\n  --primitive-teal-100: #0d3d38;\n  --primitive-teal-500: #2ea5a0;\n  --primitive-teal-600: #3db9b3;\n  --primitive-teal-800: #99f6e4;\n  --primitive-orange-100: #3d2a0a;\n  --primitive-orange-500: #d29922;\n  --primitive-orange-600: #e3a82b;\n  --primitive-orange-800: #f0c674;\n  --primitive-indigo-100: #252541;\n  --primitive-indigo-500: #6e6efb;\n  --primitive-indigo-600: #818cf8;\n  --primitive-indigo-800: #a5b4fc;\n  --primitive-cyan-100: #0d3d45;\n  --primitive-cyan-500: #39c5cf;\n  --primitive-cyan-600: #56d4dd;\n  --primitive-cyan-800: #a5f3fc;\n\n  /* Semantic token overrides for dark theme */\n  --text: var(--primitive-neutral-900);\n  --text-secondary: var(--primitive-neutral-700);\n  --text-tertiary: var(--primitive-neutral-600);\n  --text-muted: var(--primitive-neutral-500);\n  --text-disabled: var(--primitive-neutral-400);\n  --text-inverse: var(--primitive-neutral-0);\n\n  --surface-page: var(--primitive-neutral-50);\n  --surface: var(--primitive-neutral-0);\n  --surface-hover: var(--primitive-neutral-100);\n  --surface-selected: var(--primitive-neutral-200);\n  --surface-elev: var(--primitive-neutral-100);\n  --surface-report: var(--primitive-neutral-50);\n\n  --border: var(--primitive-neutral-200);\n  --border-subtle: var(--primitive-neutral-100);\n  --border-strong: var(--primitive-neutral-300);\n  --border-hover: var(--primitive-neutral-300);\n  --border-focus: var(--primitive-brand-500);\n  --border-error: var(--primitive-danger-500);\n\n  --brand: var(--primitive-brand-500);\n  --brand-hover: var(--primitive-brand-400);\n  --brand-fg: var(--primitive-brand-300);\n  --on-brand: var(--primitive-neutral-900);\n\n  --danger: var(--primitive-danger-500);\n  --danger-hover: var(--primitive-danger-600);\n  --on-danger: var(--primitive-neutral-900);\n  --danger-fg: var(--primitive-danger-500);\n  --danger-fg-emphasis: var(--primitive-danger-600);\n\n  --success: var(--primitive-success-500);\n  --on-success: var(--primitive-neutral-900);\n  --success-fg: var(--primitive-success-500);\n  --success-fg-emphasis: var(--primitive-success-600);\n\n  --warning: var(--primitive-warning-500);\n  --on-warning: var(--primitive-neutral-950);\n  --warning-fg: var(--primitive-warning-500);\n  --warning-fg-emphasis: var(--primitive-warning-600);\n  --warning-hover: var(--primitive-warning-600);\n\n  --info-bg: rgba(31, 111, 235, 0.15);\n  --info-bg-emphasis: rgba(31, 111, 235, 0.25);\n  --info-fg: var(--primitive-info-500);\n  --info-fg-emphasis: var(--primitive-info-400);\n  --info-stroke: rgba(31, 111, 235, 0.3);\n  --on-info: var(--primitive-neutral-900);\n  --success-hover: var(--primitive-success-600);\n  --success-stroke-emphasis: var(--primitive-success-500);\n\n  --purple-fg-emphasis: var(--primitive-purple-500);\n  --purple-bg-emphasis: var(--primitive-purple-100);\n  --pink-fg-emphasis: var(--primitive-pink-500);\n  --pink-bg-emphasis: var(--primitive-pink-100);\n  --teal-fg-emphasis: var(--primitive-teal-500);\n  --teal-bg-emphasis: var(--primitive-teal-100);\n  --orange-fg-emphasis: var(--primitive-orange-500);\n  --orange-bg-emphasis: var(--primitive-orange-100);\n  --indigo-fg-emphasis: var(--primitive-indigo-500);\n  --indigo-bg-emphasis: var(--primitive-indigo-100);\n  --cyan-fg-emphasis: var(--primitive-cyan-500);\n  --cyan-bg-emphasis: var(--primitive-cyan-100);\n\n  --badge: var(--primitive-neutral-200);\n\n  --chart-tooltip: var(--primitive-neutral-100);\n\n  --overlay: rgba(0, 0, 0, 0.8);\n\n  --shadow-footer: 0 -1px 3px rgba(0, 0, 0, 0.3);\n  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.4);\n  --shadow-md: 0 4px 12px var(--primitive-neutral-0);\n  --shadow-lg: 0 12px 32px var(--primitive-neutral-0);\n\n  --toast-bg: var(--primitive-neutral-200);\n  --toast-fg: var(--primitive-neutral-900);\n  --toast-fg-muted: var(--primitive-neutral-600);\n  --toast-close: var(--primitive-neutral-700);\n  --toast-success: var(--primitive-success-500);\n  --toast-info: var(--primitive-info-500);\n  --toast-warning: var(--primitive-warning-500);\n  --toast-danger: var(--primitive-danger-500);\n\n  /* Auth overrides for dark theme */\n  --auth-canvas: var(--primitive-neutral-0);\n  --auth-panel: var(--primitive-neutral-50);\n  --auth-panel-hover: var(--primitive-neutral-100);\n  --auth-input-bg: var(--primitive-neutral-0);\n  --auth-input-border: var(--primitive-neutral-200);\n  --auth-input-border-focus: var(--primitive-neutral-400);\n  --auth-text-primary: var(--primitive-neutral-900);\n  --auth-text-secondary: var(--primitive-neutral-700);\n  --auth-text-muted: var(--primitive-neutral-500);\n  --auth-text-light: var(--primitive-neutral-600);\n  --auth-accent: var(--primitive-brand-500);\n  --auth-accent-medium: var(--primitive-brand-600);\n  --auth-accent-hover: var(--primitive-brand-400);\n  --auth-border: var(--primitive-neutral-200);\n  --auth-border-light: var(--primitive-neutral-300);\n  --auth-border-hover: var(--primitive-neutral-300);\n  --auth-error-bg-light: var(--primitive-danger-100);\n  --auth-error-border: var(--primitive-danger-500);\n  --auth-error-text: var(--primitive-danger-500);\n  --auth-feature-card-bg: var(--primitive-neutral-50);\n  --auth-feature-card-hover: var(--primitive-neutral-100);\n  --auth-feature-card-border: var(--primitive-neutral-200);\n  --auth-card-icon-bg: var(--primitive-neutral-100);\n  --auth-card-icon-hover: var(--primitive-neutral-200);\n  --auth-card-icon-border: var(--primitive-neutral-200);\n  --auth-badge-bg: var(--primitive-neutral-100);\n  --auth-badge-border: var(--primitive-neutral-50);\n  --auth-badge-icon: var(--primitive-neutral-500);\n\n  /* RGBA overrides (cannot derive from primitives) */\n  --brand-muted: rgba(31, 111, 235, 0.15);\n  --success-bg: rgba(46, 160, 67, 0.15);\n  --warning-bg: rgba(210, 153, 34, 0.15);\n  --danger-bg: rgba(218, 54, 51, 0.15);\n  --auth-error-bg: rgba(218, 54, 51, 0.15);\n}\n\n/* ─────────────────────────────────────────────────────────────────────────\n   DARK THEME: noir-studio\n   Primitives change + semantic token overrides\n   ───────────────────────────────────────────────────────────────────────── */\n\n[data-theme='noir-studio'] {\n  /* Primitive overrides for noir-studio theme */\n  --primitive-brand-50: #d6edfc;\n  --primitive-brand-100: #b3dff9;\n  --primitive-brand-200: #7dc6f2;\n  --primitive-brand-300: #47a8e5;\n  --primitive-brand-400: #1e88d4;\n  --primitive-brand-500: #0a6bb5;\n  --primitive-brand-600: #085691;\n  --primitive-brand-700: #064574;\n  --primitive-brand-800: #05365b;\n  --primitive-brand-900: #032a46;\n  --primitive-brand-950: #021829;\n\n  --primitive-neutral-0: #0d0d0d;\n  --primitive-neutral-50: #121212;\n  --primitive-neutral-100: #171717;\n  --primitive-neutral-200: #202020;\n  --primitive-neutral-300: #2e2e2e;\n  --primitive-neutral-400: #3d3d3d;\n  --primitive-neutral-500: #555555;\n  --primitive-neutral-600: #777777;\n  --primitive-neutral-700: #a0a0a0;\n  --primitive-neutral-800: #d0d0d0;\n  --primitive-neutral-900: #f5f5f5;\n  --primitive-neutral-950: #ffffff;\n\n  --primitive-success-50: #0d2818;\n  --primitive-success-100: #134d22;\n  --primitive-success-200: #166534;\n  --primitive-success-500: #1b784c;\n  --primitive-success-600: #166534;\n  --primitive-success-700: #145c26;\n  --primitive-success-800: #134d22;\n\n  --primitive-warning-50: #3d3208;\n  --primitive-warning-100: #5c4a0c;\n  --primitive-warning-200: #8b6f12;\n  --primitive-warning-300: #c49418;\n  --primitive-warning-500: #ffc247;\n  --primitive-warning-600: #eab308;\n  --primitive-warning-700: #ca8a04;\n  --primitive-warning-800: #a16207;\n\n  --primitive-danger-50: #3d1616;\n  --primitive-danger-100: #5c2222;\n  --primitive-danger-200: #8b2d2d;\n  --primitive-danger-500: #aa3232;\n  --primitive-danger-600: #922b2b;\n  --primitive-danger-700: #7a2424;\n  --primitive-danger-800: #621d1d;\n\n  --primitive-info-500: #1f6feb;\n  --primitive-info-400: #58a0ff;\n\n  --primitive-purple-100: #2a1a3d;\n  --primitive-purple-500: #9f67e8;\n  --primitive-purple-600: #b794f6;\n  --primitive-purple-800: #ddd6fe;\n  --primitive-pink-100: #3d1f33;\n  --primitive-pink-500: #e879a9;\n  --primitive-pink-600: #f472b6;\n  --primitive-pink-800: #fbcfe8;\n  --primitive-teal-100: #0f3d38;\n  --primitive-teal-500: #2dd4bf;\n  --primitive-teal-600: #5eead4;\n  --primitive-teal-800: #99f6e4;\n  --primitive-orange-100: #3d2a0f;\n  --primitive-orange-500: #fb923c;\n  --primitive-orange-600: #fdba74;\n  --primitive-orange-800: #fed7aa;\n  --primitive-indigo-100: #28264a;\n  --primitive-indigo-500: #818cf8;\n  --primitive-indigo-600: #a5b4fc;\n  --primitive-indigo-800: #c7d2fe;\n  --primitive-cyan-100: #0f3d45;\n  --primitive-cyan-500: #22d3ee;\n  --primitive-cyan-600: #67e8f9;\n  --primitive-cyan-800: #a5f3fc;\n\n  /* Semantic token overrides for dark theme */\n  --text: var(--primitive-neutral-900);\n  --text-secondary: var(--primitive-neutral-700);\n  --text-tertiary: var(--primitive-neutral-600);\n  --text-muted: var(--primitive-neutral-500);\n  --text-disabled: var(--primitive-neutral-400);\n  --text-inverse: var(--primitive-neutral-0);\n\n  --surface-page: var(--primitive-neutral-50);\n  --surface: var(--primitive-neutral-0);\n  --surface-hover: var(--primitive-neutral-100);\n  --surface-selected: var(--primitive-neutral-200);\n  --surface-elev: var(--primitive-neutral-100);\n  --surface-report: var(--primitive-neutral-50);\n\n  --border: var(--primitive-neutral-200);\n  --border-subtle: var(--primitive-neutral-100);\n  --border-strong: var(--primitive-neutral-300);\n  --border-hover: var(--primitive-neutral-300);\n  --border-focus: var(--primitive-brand-500);\n  --border-error: var(--primitive-danger-500);\n\n  --brand: var(--primitive-brand-500);\n  --brand-hover: var(--primitive-brand-400);\n  --brand-fg: var(--primitive-brand-300);\n  --on-brand: var(--primitive-neutral-900);\n\n  --danger: var(--primitive-danger-500);\n  --danger-hover: var(--primitive-danger-600);\n  --on-danger: var(--primitive-neutral-900);\n  --danger-fg: var(--primitive-danger-500);\n  --danger-fg-emphasis: var(--primitive-danger-600);\n\n  --success: var(--primitive-success-500);\n  --on-success: var(--primitive-neutral-900);\n  --success-fg: var(--primitive-success-500);\n  --success-fg-emphasis: var(--primitive-success-600);\n\n  --warning: var(--primitive-warning-500);\n  --on-warning: var(--primitive-neutral-950);\n  --warning-fg: var(--primitive-warning-500);\n  --warning-fg-emphasis: var(--primitive-warning-600);\n  --warning-hover: var(--primitive-warning-600);\n\n  --info-bg: rgba(31, 111, 235, 0.15);\n  --info-bg-emphasis: rgba(31, 111, 235, 0.25);\n  --info-fg: var(--primitive-info-500);\n  --info-fg-emphasis: var(--primitive-info-400);\n  --info-stroke: rgba(31, 111, 235, 0.3);\n  --on-info: var(--primitive-neutral-900);\n  --success-hover: var(--primitive-success-600);\n  --success-stroke-emphasis: var(--primitive-success-500);\n\n  --purple-fg-emphasis: var(--primitive-purple-500);\n  --purple-bg-emphasis: var(--primitive-purple-100);\n  --pink-fg-emphasis: var(--primitive-pink-500);\n  --pink-bg-emphasis: var(--primitive-pink-100);\n  --teal-fg-emphasis: var(--primitive-teal-500);\n  --teal-bg-emphasis: var(--primitive-teal-100);\n  --orange-fg-emphasis: var(--primitive-orange-500);\n  --orange-bg-emphasis: var(--primitive-orange-100);\n  --indigo-fg-emphasis: var(--primitive-indigo-500);\n  --indigo-bg-emphasis: var(--primitive-indigo-100);\n  --cyan-fg-emphasis: var(--primitive-cyan-500);\n  --cyan-bg-emphasis: var(--primitive-cyan-100);\n\n  --badge: var(--primitive-neutral-200);\n\n  --chart-tooltip: var(--primitive-neutral-100);\n\n  --overlay: rgba(0, 0, 0, 0.8);\n\n  --shadow-footer: 0 -1px 3px rgba(0, 0, 0, 0.3);\n  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.4);\n  --shadow-md: 0 4px 12px var(--primitive-neutral-0);\n  --shadow-lg: 0 12px 32px var(--primitive-neutral-0);\n\n  --toast-bg: var(--primitive-neutral-200);\n  --toast-fg: var(--primitive-neutral-900);\n  --toast-fg-muted: var(--primitive-neutral-600);\n  --toast-close: var(--primitive-neutral-700);\n  --toast-success: var(--primitive-success-500);\n  --toast-info: var(--primitive-info-500);\n  --toast-warning: var(--primitive-warning-500);\n  --toast-danger: var(--primitive-danger-500);\n\n  /* Auth overrides for dark theme */\n  --auth-canvas: var(--primitive-neutral-0);\n  --auth-panel: var(--primitive-neutral-50);\n  --auth-panel-hover: var(--primitive-neutral-100);\n  --auth-input-bg: var(--primitive-neutral-0);\n  --auth-input-border: var(--primitive-neutral-200);\n  --auth-input-border-focus: var(--primitive-neutral-400);\n  --auth-text-primary: var(--primitive-neutral-900);\n  --auth-text-secondary: var(--primitive-neutral-700);\n  --auth-text-muted: var(--primitive-neutral-500);\n  --auth-text-light: var(--primitive-neutral-600);\n  --auth-accent: var(--primitive-brand-500);\n  --auth-accent-medium: var(--primitive-brand-600);\n  --auth-accent-hover: var(--primitive-brand-400);\n  --auth-border: var(--primitive-neutral-200);\n  --auth-border-light: var(--primitive-neutral-300);\n  --auth-border-hover: var(--primitive-neutral-300);\n  --auth-error-bg-light: var(--primitive-danger-100);\n  --auth-error-border: var(--primitive-danger-500);\n  --auth-error-text: var(--primitive-danger-500);\n  --a