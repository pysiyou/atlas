{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/rejection-reasons.schema.json",
  "title": "Atlas rejection reason registry",
  "type": "object",
  "required": ["reasons"],
  "properties": {
    "$schema": { "type": "string" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "domain"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "enum": ["specimen", "analytical"] },
          "legacyEnumWire": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
