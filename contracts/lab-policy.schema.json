{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/lab-policy.schema.json",
  "title": "Atlas lab policy contract",
  "type": "object",
  "required": ["limits", "blockers", "presentation", "reporting", "priority", "qualityWorkflow"],
  "properties": {
    "$schema": { "type": "string" },
    "limits": {
      "type": "object",
      "required": [
        "MAX_RETEST_ATTEMPTS",
        "MAX_RECOLLECTION_ATTEMPTS",
        "QUEUE_AGE_WARNING_HOURS",
        "QUEUE_AGE_CRITICAL_HOURS",
        "SPECIMEN_DEAD_VOLUME_ML"
      ],
      "additionalProperties": { "type": "number" }
    },
    "blockers": {
      "type": "object",
      "required": ["reasons"],
      "properties": {
        "allowedActionKeys": { "type": "array", "items": { "type": "string" } },
        "pipelineStages": { "type": "array", "items": { "type": "string" } },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "attentionType"],
            "properties": {
              "label": { "type": "string" },
              "attentionType": { "type": "string" },
              "blocksProgress": { "type": "boolean" }
            }
          }
        },
        "attentionTypeSort": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "supervisorAttentionTypes": { "type": "array", "items": { "type": "string" } },
        "priorityAttentionTypes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["terminalTestStatuses", "statusToPrimary", "blockedOverlay"],
      "properties": {
        "terminalTestStatuses": { "type": "array", "items": { "type": "string" } },
        "statusToPrimary": {
          "type": "object",
          "required": ["order", "test", "sample"],
          "properties": {
            "order": { "type": "object", "additionalProperties": { "type": "string" } },
            "test": { "type": "object", "additionalProperties": { "type": "string" } },
            "sample": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "blockedOverlay": {
          "type": "object",
          "properties": {
            "test": {
              "type": "object",
              "properties": {
                "excludeStatusesRef": { "const": "terminalTestStatuses" },
                "whenReasonBlocksProgress": { "type": "boolean" }
              }
            },
            "sample": {
              "type": "object",
              "properties": {
                "whenStatus": { "type": "string" },
                "whenReasonBlocksProgress": { "type": "boolean" }
              }
            }
          }
        },
        "secondaryRules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "whenStatus": { "type": "string" },
              "fromAttentionLabel": { "type": "boolean" }
            }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "required": [
        "inactiveTestStatusesForReports",
        "inactiveTestStatusesForRollup",
        "inactiveTestStatusesForBilling"
      ],
      "properties": {
        "inactiveTestStatusesForReports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inactiveTestStatusesForRollup": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inactiveTestStatusesForBilling": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "priority": {
      "type": "object",
      "required": ["rank", "weight"],
      "properties": {
        "rank": { "type": "object", "additionalProperties": { "type": "integer" } },
        "weight": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "qualityWorkflow": {
      "type": "object",
      "required": [
        "validation",
        "sampleUnfinished",
        "successToasts",
        "defaultSuccessToast",
        "remedyPresentation"
      ],
      "properties": {
        "validation": { "$ref": "#/definitions/remedyContextPolicy" },
        "sampleUnfinished": { "$ref": "#/definitions/remedyContextPolicy" },
        "successToasts": {
          "type": "array",
          "items": { "$ref": "#/definitions/successToastRule" }
        },
        "defaultSuccessToast": { "type": "string" },
        "remedyPresentation": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "validation": { "$ref": "#/definitions/remedyPresentationFields" },
              "sample": { "$ref": "#/definitions/remedyPresentationFields" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "remedyContextPolicy": {
      "type": "object",
      "required": ["allowedRemedies", "displayOrder"],
      "properties": {
        "allowedRemedies": { "type": "array", "items": { "type": "string" } },
        "displayOrder": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "successToastRule": {
      "type": "object",
      "required": ["remedy", "feedbackId", "when"],
      "properties": {
        "remedy": { "type": "string" },
        "feedbackId": { "type": "string" },
        "when": {
          "type": "object",
          "properties": {
            "escalationRequired": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "remedyPresentationFields": {
      "type": "object",
      "required": ["labelFeedbackId", "descriptionFeedbackId"],
      "properties": {
        "labelFeedbackId": { "type": "string" },
        "descriptionFeedbackId": { "type": "string" },
        "limitDescriptionFeedbackId": { "type": "string" },
        "supervisorHintFeedbackId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
