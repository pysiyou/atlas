{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/audit-events.schema.json",
  "title": "Atlas audit event taxonomy",
  "type": "object",
  "required": ["events", "query"],
  "properties": {
    "$schema": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["member", "wire", "domain", "domainLabel", "verbPhrase"],
        "properties": {
          "member": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "wire": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "domain": { "type": "string" },
          "laboratorySubdomain": { "type": "string" },
          "domainLabel": { "type": "string" },
          "verbPhrase": { "type": "string" },
          "headlineMetaKeys": {
            "type": "array",
            "items": { "type": "string" }
          },
          "leadingActor": { "type": "boolean" },
          "trailingActor": { "enum": ["human", "never"] },
          "treatAsSystemActor": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "query": {
      "type": "object",
      "required": [
        "domainKinds",
        "laboratorySubkinds",
        "accessEventTypes",
        "storedEventScopes",
        "storedScopeByEventPrefix",
        "defaultStoredEventScope"
      ],
      "properties": {
        "domainKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "eventTypePrefix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "eventTypePrefix": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "laboratorySubkinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "subdomain", "label", "eventTypePrefix"],
            "properties": {
              "id": { "type": "string" },
              "subdomain": { "type": "string" },
              "label": { "type": "string" },
              "eventTypePrefix": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "accessEventTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "storedEventScopes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "storedScopeByEventPrefix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prefix", "scope"],
            "properties": {
              "prefix": { "type": "string" },
              "scope": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "defaultStoredEventScope": {
          "type": "string",
          "description": "Stored event_scope when no storedScopeByEventPrefix rule matches (e.g. order, billing, reporting)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
