{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/feedback.schema.json",
  "title": "Atlas user feedback catalog",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["channel", "variant", "title"],
        "properties": {
          "channel": {
            "enum": ["toast", "alert", "errorAlert", "inline"]
          },
          "variant": {
            "enum": ["success", "error", "warning", "info", "danger"]
          },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Short toast label (e.g. collected, validated, rejected, failed)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "channel": { "enum": ["toast", "alert", "errorAlert"] }
              },
              "required": ["channel"]
            },
            "then": { "required": ["brief"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
