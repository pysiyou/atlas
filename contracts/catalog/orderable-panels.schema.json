{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/catalog/orderable-panels.schema.json",
  "title": "Atlas orderable panel registry",
  "type": "object",
  "required": ["panels"],
  "properties": {
    "panels": {
      "type": "array",
      "items": { "$ref": "#/$defs/panelEntry" },
      "minItems": 1
    }
  },
  "$defs": {
    "panelId": {
      "type": "string",
      "description": "Clinical panel mnemonic (LIPID, CMP, LFT), 2–8 uppercase characters",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "minLength": 2,
      "maxLength": 8
    },
    "panelEntry": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/panelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}