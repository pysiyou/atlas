{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/catalog/orderable-panels.schema.json",
  "title": "Atlas orderable panel registry",
  "type": "object",
  "required": ["panels"],
  "properties": {
    "$schema": { "type": "string" },
    "panels": {
      "type": "array",
      "items": { "$ref": "#/definitions/panelEntry" },
      "minItems": 1
    }
  },
  "definitions": {
    "panelId": {
      "type": "string",
      "description": "Orderable battery mnemonic (CBC, LIPID, CMP, LFT), 2–8 uppercase characters. Identifies a LOINC Order panel or clinical order set, not an individual analyte.",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "minLength": 2,
      "maxLength": 8
    },
    "loincCode": {
      "type": "string",
      "description": "Order-level LOINC panel/battery code (e.g., 57021-8 CBC W Auto Differential). A panel code has no single numeric result.",
      "pattern": "^[0-9]{1,5}-[0-9]$"
    },
    "panelEntry": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/panelId" },
        "loinc_code": { "$ref": "#/definitions/loincCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
