{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/catalog/analyte-catalog.schema.json",
  "title": "Atlas analyte catalog",
  "description": "Registry of individual measurable laboratory parameters (analytes/observations). Field names are snake_case and align with catalogContracts types and lab result utilities.",
  "type": "object",
  "required": ["analytes"],
  "properties": {
    "$schema": { "type": "string" },
    "analytes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/analyteEntry" }
    }
  },
  "definitions": {
    "analyteCode": {
      "type": "string",
      "description": "Clinical analyte mnemonic (e.g., HGB, WBC, UA_pH)",
      "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
      "minLength": 1,
      "maxLength": 32
    },
    "loincCode": {
      "type": "string",
      "description": "LOINC observation code (e.g., 718-7, 3016-3)",
      "pattern": "^[0-9]{1,5}-[0-9]$"
    },
    "valueType": {
      "type": "string",
      "enum": ["NUMERIC", "SELECT", "TEXT"],
      "description": "NUMERIC: quantitative results; SELECT: coded/ordinal pick list; TEXT: free text"
    },
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "demographicRange": {
      "type": "object",
      "description": "One reference interval band (numeric bounds and/or interpretive text)",
      "additionalProperties": false,
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Short interpretive reference (e.g. Negative, No growth)"
        }
      },
      "anyOf": [
        { "required": ["low"] },
        { "required": ["high"] },
        { "required": ["text"] }
      ]
    },
    "referenceRange": {
      "type": "object",
      "description": "SI / IFCC-style demographic reference bands only. Utilities resolve pediatric → sex → adult_general.",
      "additionalProperties": false,
      "properties": {
        "adult_general": { "$ref": "#/definitions/demographicRange" },
        "adult_male": { "$ref": "#/definitions/demographicRange" },
        "adult_female": { "$ref": "#/definitions/demographicRange" },
        "pediatric": { "$ref": "#/definitions/demographicRange" }
      }
    },
    "criticalRange": {
      "type": "object",
      "description": "Panic / critical limits (numeric only)",
      "additionalProperties": false,
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "physiologicRange": {
      "type": "object",
      "description": "Broad physiologic feasibility limits for entry validation",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "validationBlock": {
      "type": "object",
      "required": ["rejection_criteria"],
      "additionalProperties": true,
      "properties": {
        "rejection_criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/rejectionReasonId" },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "analyteEntry": {
      "type": "object",
      "required": ["analyte_code", "name", "validation"],
      "additionalProperties": true,
      "properties": {
        "analyte_code": { "$ref": "#/definitions/analyteCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "loinc_code": { "$ref": "#/definitions/loincCode" },
        "specimen": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value_type": { "$ref": "#/definitions/valueType" },
        "unit": {
          "type": "string",
          "maxLength": 50,
          "description": "UCUM or conventional unit string; required for NUMERIC analytes"
        },
        "decimals_suggested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Suggested decimal places for NUMERIC entry/display"
        },
        "allowed_values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Required for SELECT value_type"
        },
        "reference_range": { "$ref": "#/definitions/referenceRange" },
        "critical_range": { "$ref": "#/definitions/criticalRange" },
        "physiologic_range": { "$ref": "#/definitions/physiologicRange" },
        "citations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "uniqueItems": true
        },
        "sample": {
          "type": "object",
          "properties": {
            "rejection_criteria": {
              "type": "array",
              "items": { "$ref": "#/definitions/rejectionReasonId" },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "validation": { "$ref": "#/definitions/validationBlock" }
      },
      "allOf": [
        {
          "if": { "properties": { "value_type": { "const": "NUMERIC" } }, "required": ["value_type"] },
          "then": {
            "required": ["unit", "reference_range"]
          }
        },
        {
          "if": { "properties": { "value_type": { "const": "SELECT" } }, "required": ["value_type"] },
          "then": {
            "required": ["allowed_values"]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}