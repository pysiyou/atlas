{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/catalog/test-catalog.schema.json",
  "title": "Atlas test catalog",
  "type": "object",
  "required": ["tests"],
  "properties": {
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/testEntry" }
    }
  },
  "$defs": {
    "orderablePanelId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "minLength": 2,
      "maxLength": 8
    },
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "testEntry": {
      "type": "object",
      "required": ["test_code"],
      "properties": {
        "test_code": {
          "type": "string",
          "description": "Clinical mnemonic (CBC, TSH), not a sequential HEM001 code and not a LOINC primary key",
          "pattern": "^[A-Z][A-Z0-9]{1,7}$",
          "minLength": 2,
          "maxLength": 8
        },
        "sample": {
          "type": "object",
          "properties": {
            "rejection_criteria": {
              "type": "array",
              "items": { "$ref": "#/$defs/rejectionReasonId" }
            }
          },
          "additionalProperties": true
        },
        "validation_rejection_criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/rejectionReasonId" }
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderablePanelId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
