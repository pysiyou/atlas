{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/contracts/catalog/test-catalog.schema.json",
  "title": "Atlas test catalog",
  "type": "object",
  "required": ["tests"],
  "properties": {
    "$schema": { "type": "string" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/definitions/testEntry" }
    }
  },
  "definitions": {
    "analyteId": {
      "type": "string",
      "description": "Clinical analyte/observation mnemonic (HGB, WBC, TSH), 2–8 uppercase characters. Not a sequential HEM001 code, not a LOINC primary key, and not an order-only panel (CBC / 57021-8).",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "minLength": 2,
      "maxLength": 8
    },
    "loincCode": {
      "type": "string",
      "description": "Observation-level LOINC (e.g., 718-7 Hemoglobin, 3016-3 TSH), not an order/panel code (57021-8).",
      "pattern": "^[0-9]{1,5}-[0-9]$"
    },
    "orderablePanelId": {
      "type": "string",
      "description": "Membership id into the orderable panel registry (CBC, LIPID, CMP, HEMFULL).",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$",
      "minLength": 2,
      "maxLength": 8
    },
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "resultItem": {
      "type": "object",
      "required": ["item_code"],
      "properties": {
        "item_code": { "type": "string", "minLength": 1 },
        "loinc_code": {
          "$ref": "#/definitions/loincCode",
          "description": "Observation-level LOINC for this reportable parameter (e.g., 718-7 for HGB)."
        }
      },
      "additionalProperties": true
    },
    "testEntry": {
      "type": "object",
      "required": ["test_code"],
      "properties": {
        "test_code": {
          "$ref": "#/definitions/analyteId"
        },
        "loinc_codes": {
          "type": "array",
          "description": "Observation-level LOINC codes for this catalog entry (union of result_item.loinc_code).",
          "items": { "$ref": "#/definitions/loincCode" },
          "uniqueItems": true
        },
        "result_items": {
          "type": "array",
          "items": { "$ref": "#/definitions/resultItem" }
        },
        "order_obs": {
          "type": "string",
          "description": "LOINC ORDER_OBS role. observation = reportable only; both = may be ordered alone (e.g. TSH).",
          "enum": ["observation", "both"]
        },
        "sample": {
          "type": "object",
          "properties": {
            "rejection_criteria": {
              "type": "array",
              "items": { "$ref": "#/definitions/rejectionReasonId" }
            }
          },
          "additionalProperties": true
        },
        "validation_rejection_criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/rejectionReasonId" }
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/definitions/orderablePanelId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
