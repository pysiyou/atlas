{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/contracts/workups.schema.json",
  "title": "Atlas clinical workups",
  "type": "object",
  "required": ["workups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "workups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workupEntry" }
    }
  },
  "$defs": {
    "testCode": { "$ref": "https://atlas.local/contracts/_schema/common.defs.json#/$defs/testCode" },
    "workupEntry": {
      "type": "object",
      "required": ["id", "name", "test_codes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,15}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "test_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/testCode" },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}