{
  "$schema": "http://json-schema.org",
  "$id": "https://atlas.local/contracts/rejection-analytical.schema.json",
  "title": "Atlas result (analytical) rejection reasons registry",
  "type": "object",
  "required": ["reasons"],
  "properties": {
    "$schema": { "type": "string" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/resultRejectionReason" }
    }
  },
  "definitions": {
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "resultRejectionReason": {
      "type": "object",
      "required": ["id", "label", "stage"],
      "properties": {
        "id": { "$ref": "#/definitions/rejectionReasonId" },
        "label": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "enum": [
            "analytical_qc",
            "linearity_interference",
            "delta_check",
            "critical_panic",
            "clinical_review"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}