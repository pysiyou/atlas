{
  "$schema": "http://json-schema.org",
  "$id": "https://atlas.local/registries/sample-rejection-reasons",
  "title": "Atlas sample (specimen) rejection reasons registry",
  "type": "object",
  "required": ["reasons"],
  "properties": {
    "$schema": { "type": "string" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sampleRejectionReason" }
    }
  },
  "definitions": {
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "sampleRejectionReason": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/rejectionReasonId" },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}