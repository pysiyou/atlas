{
  "$schema": "http://json-schema.org",
  "$id": "https://atlas.local/registries/sample-rejection-reasons",
  "title": "Atlas sample (specimen) rejection reasons registry",
  "type": "object",
  "required": ["reasons"],
  "properties": {
    "$schema": { "type": "string" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sampleRejectionReason" }
    }
  },
  "definitions": {
    "rejectionReasonId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "sampleRejectionReason": {
      "type": "object",
      "required": ["id", "code", "label", "domain", "category"],
      "properties": {
        "id": { "$ref": "#/definitions/rejectionReasonId" },
        "domain": { "const": "specimen" },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Interop code (HL7 v2-0490 / LOINC AnswerList / Atlas mnemonic)"
        },
        "label": { "type": "string", "minLength": 1 },
        "label_it": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "specimen_integrity",
            "container_volume",
            "identification_labeling",
            "stability_transport",
            "serum_index"
          ]
        },
        "requires_recollection": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}