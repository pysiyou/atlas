{
  "$schema": "./lab.schema.json",
  "limits": {
    "MAX_RETEST_ATTEMPTS": 2,
    "MAX_RECOLLECTION_ATTEMPTS": 2,
    "QUEUE_AGE_WARNING_HOURS": 4,
    "QUEUE_AGE_CRITICAL_HOURS": 8
  },
  "blockers": {
    "allowedActionKeys": ["collect", "enterResults", "validate", "reject"],
    "pipelineStages": [
      "collection",
      "entry",
      "validation",
      "escalation",
      "completed",
      "cancelled"
    ],
    "reasons": {
      "payment_unpaid": {
        "label": "Payment required",
        "attentionType": "payment_blocked",
        "blocksProgress": true
      },
      "sample_rejected": {
        "label": "Sample rejected",
        "attentionType": "sample_rejected",
        "blocksProgress": true
      },
      "critical_value": {
        "label": "Critical value — supervisor review",
        "attentionType": "escalation_critical",
        "blocksProgress": true
      },
      "amendment_pending": {
        "label": "Amendment pending",
        "attentionType": "escalation_amendment",
        "blocksProgress": true
      },
      "retry_limit": {
        "label": "Re-test limit reached",
        "attentionType": "escalation_retry_limit",
        "blocksProgress": true
      },
      "recollection_limit": {
        "label": "Recollection limit reached",
        "attentionType": "escalation_recollection_limit",
        "blocksProgress": true
      },
      "supervisor_review": {
        "label": "Supervisor approval required",
        "attentionType": "supervisor_approval",
        "blocksProgress": true
      },
      "recollection_approval": {
        "label": "Recollection awaiting supervisor approval",
        "attentionType": "supervisor_recollection_request",
        "blocksProgress": true
      }
    },
    "attentionTypeSort": {
      "escalation_critical": 10,
      "escalation_amendment": 20,
      "escalation_retry_limit": 30,
      "escalation_recollection_limit": 40,
      "supervisor_approval": 45,
      "supervisor_recollection_request": 48,
      "payment_blocked": 50,
      "sample_rejected": 60,
      "priority_urgent": 82,
      "priority_high": 84,
      "queue_overdue_critical": 90,
      "queue_overdue_warning": 100
    },
    "supervisorAttentionTypes": [
      "escalation_critical",
      "escalation_amendment",
      "escalation_retry_limit",
      "escalation_recollection_limit",
      "supervisor_approval",
      "supervisor_recollection_request"
    ],
    "priorityAttentionTypes": ["priority_urgent", "priority_high"]
  },
  "presentation": {
    "terminalTestStatuses": ["validated", "cancelled", "superseded", "removed"],
    "statusToPrimary": {
      "order": {
        "ordered": "pending",
        "running": "in_progress",
        "completed": "completed",
        "cancelled": "cancelled"
      },
      "test": {
        "pending": "pending",
        "sample-collected": "in_progress",
        "resulted": "in_progress",
        "validated": "completed",
        "cancelled": "cancelled",
        "escalated": "escalated",
        "superseded": "superseded",
        "removed": "removed"
      },
      "sample": {
        "pending": "pending",
        "collected": "in_progress",
        "rejected": "rejected"
      }
    },
    "blockedOverlay": {
      "test": {
        "excludeStatusesRef": "terminalTestStatuses",
        "whenReasonBlocksProgress": true
      },
      "sample": {
        "whenStatus": "pending",
        "whenReasonBlocksProgress": true
      }
    },
    "secondaryRules": {
      "testEscalated": {
        "whenStatus": "escalated",
        "fromAttentionLabel": true
      }
    }
  },
  "reporting": {
    "inactiveTestStatusesForReports": ["removed", "superseded"],
    "inactiveTestStatusesForRollup": ["removed", "superseded", "cancelled"]
  },
  "priority": {
    "rank": {
      "urgent": 0,
      "high": 1,
      "medium": 2,
      "low": 3
    },
    "weight": {
      "urgent": 4,
      "high": 3,
      "medium": 2,
      "low": 1
    }
  }
}
